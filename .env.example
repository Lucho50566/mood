# Copiá a .env y completá. Docker Compose lo lee solo.
# En systemd, cargá estas variables en el unit o en /etc/mood.env.

PORT=4400
# URL pública HTTPS (necesaria para PWA, Mercado Pago y webhooks)
PUBLIC_URL=https://mood.tudominio.com

# Opcional: si no querés cargar el token desde el panel
# MP_ACCESS_TOKEN=APP_USR-...
